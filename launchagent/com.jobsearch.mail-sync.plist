<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jobsearch.mail-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>PLACEHOLDER_NODE</string>
    <string>PLACEHOLDER_PROJECT_PATH/scripts/sync-emails.js</string>
  </array>
  <key>StartInterval</key>
  <integer>600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>ANTHROPIC_API_KEY</key>
    <string>PLACEHOLDER_API_KEY</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/job-search-sync.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/job-search-sync.error.log</string>
</dict>
</plist>
